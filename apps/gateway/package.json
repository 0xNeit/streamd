{
  "name": "@streamd/gateway",
  "version": "0.1.0",
  "description": "A self-hosted streamd gateway: one poller per descriptor, fanned out as Server-Sent Events and WebSocket streams, and a GatewayAdapter for browser clients",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@streamd/core": "workspace:*"
  },
  "license": "MIT"
}
