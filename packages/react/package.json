{
  "name": "@streamd/react",
  "version": "0.1.0",
  "description": "React hooks for streamd: live events and historical queries in components",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@streamd/core": "workspace:*"
  },
  "peerDependencies": {
    "@aptos-labs/ts-sdk": ">=1.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@aptos-labs/ts-sdk": "^6.3.1",
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "license": "MIT"
}
