{
  "name": "@streamd/sui",
  "version": "0.1.0",
  "description": "Sui events through the streamd client: a SuiAdapter over the Sui gRPC API",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./framework": {
      "import": {
        "types": "./dist/framework.d.ts",
        "default": "./dist/framework.js"
      },
      "require": {
        "types": "./dist/framework.d.cts",
        "default": "./dist/framework.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "test:integration": "STREAMD_INTEGRATION=1 bun test tests/integration"
  },
  "dependencies": {
    "@streamd/core": "workspace:*"
  },
  "peerDependencies": {
    "@mysten/sui": "2.39.1"
  },
  "devDependencies": {
    "@aptos-labs/ts-sdk": "^6.3.1"
  },
  "license": "MIT"
}
